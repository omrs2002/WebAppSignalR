@page
<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h1>SignalR Chat</h1>
            <div id="connectionStatus" class="alert alert-info" role="status">
                Connecting...
            </div>
        </div>
    </div>

    <form>
        <div class="row mb-3">
            <div class="col-md-2">
                <label for="userInput" class="form-label">User Name:</label>
            </div>
            <div class="col-md-4">
                <input type="text" 
                       id="userInput" 
                       class="form-control" 
                       placeholder="Enter your name"
                       maxlength="50"
                       aria-label="User name"
                       aria-describedby="userHelp" />
                <small id="userHelp" class="form-text text-muted">Max 50 characters</small>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-2">
                <label for="messageInput" class="form-label">Message:</label>
            </div>
            <div class="col-md-4">
                <input type="text" 
                       id="messageInput" 
                       class="form-control" 
                       placeholder="Type your message here"
                       maxlength="1000"
                       aria-label="Message"
                       aria-describedby="messageHelp" />
                <small id="messageHelp" class="form-text text-muted">Max 1000 characters</small>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <button type="button" 
                        id="sendButton" 
                        class="btn btn-primary" 
                        aria-label="Send message">
                    Send Message
                </button>
            </div>
        </div>
    </form>

    <hr />

    <div class="row">
        <div class="col-md-8">
            <h3>Chat History</h3>
            <ul id="messagesList" 
                class="list-unstyled border rounded p-3" 
                style="max-height: 400px; overflow-y: auto;" 
                role="log" 
                aria-live="polite" 
                aria-label="Chat messages">
            </ul>
        </div>
    </div>
</div>

<style>
    .message-item {
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

    .message-item:last-child {
        border-bottom: none;
    }

    .error-message {
        color: #dc3545;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

    #connectionStatus {
        margin-bottom: 20px;
    }
</style>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/chat.js"></script>