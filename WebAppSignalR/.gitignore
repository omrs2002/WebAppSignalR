## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Local History for Visual Studio
.localhistory/

# Visual Studio Version 16+
.visualstudio.com

# BakFiles created by Visual Studio when opening a solution that contains
# Visual C++ projects
*.VC.opendb
*.VC.db

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

